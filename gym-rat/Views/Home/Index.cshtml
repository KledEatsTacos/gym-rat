@{
    ViewData["Title"] = "Home Page";
}

<div class="p-5 mb-4 bg-light rounded-3 hero-section text-white" style="background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('https://images.unsplash.com/photo-1534438327276-14e5300c3a48?ixlib=rb-1.2.1&auto=format&fit=crop&w=1950&q=80'); background-size: cover; background-position: center;">
    <div class="container-fluid py-5">
        <h1 class="display-5 fw-bold">Transform Your Body</h1>
        <p class="col-md-8 fs-4">Join Gym Rat today and get access to top-tier equipment, expert trainers, and AI-powered workout plans tailored just for you.</p>
        <a class="btn btn-primary btn-lg" asp-area="Identity" asp-page="/Account/Register">Get Started</a>
    </div>
</div>

<div class="row align-items-md-stretch">
    <div class="col-md-4 mb-4">
        <div class="h-100 p-5 text-white bg-dark rounded-3">
            <h2>Expert Trainers</h2>
            <p>Our certified trainers are here to guide you through every step of your fitness journey. Book a session today.</p>
            <a class="btn btn-outline-light" asp-controller="Trainers" asp-action="Index">View Trainers</a>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="h-100 p-5 bg-light border rounded-3">
            <h2>AI Workout Plans</h2>
            <p>Upload your stats and let our AI generate a personalized workout and diet plan to help you reach your goals faster.</p>
            <a class="btn btn-outline-secondary" asp-controller="AI" asp-action="Index">Try AI Tool</a>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="h-100 p-5 text-white bg-primary rounded-3">
            <h2>Premium Facilities</h2>
            <p>Experience our state-of-the-art equipment, sauna, and recovery zones. Open 24/7 for your convenience.</p>
            <a class="btn btn-light text-primary" asp-controller="Services" asp-action="Index">See Services</a>
        </div>
    </div>
</div>

<div class="row mt-5">
    <div class="col-12 text-center">
        <h2 class="mb-4">Why Choose Us?</h2>
    </div>
    <div class="col-md-4 text-center">
        <div class="fs-1 text-primary mb-3"><i class="bi bi-heart-pulse"></i></div>
        <h4>Health Focused</h4>
        <p>We prioritize your long-term health with sustainable fitness programs.</p>
    </div>
    <div class="col-md-4 text-center">
        <div class="fs-1 text-primary mb-3"><i class="bi bi-people"></i></div>
        <h4>Community</h4>
        <p>Join a supportive community of like-minded individuals.</p>
    </div>
    <div class="col-md-4 text-center">
        <div class="fs-1 text-primary mb-3"><i class="bi bi-graph-up-arrow"></i></div>
        <h4>Progress Tracking</h4>
        <p>Track your gains and improvements with our integrated app tools.</p>
    </div>
</div>
