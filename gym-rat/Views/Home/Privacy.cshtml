@{
    ViewData["Title"] = "Privacy Policy";
}
<h1>@ViewData["Title"]</h1>

<div class="text-center py-5">
    <h1 class="display-4"><i class="bi bi-shield-lock-fill text-primary"></i> @ViewData["Title"]</h1>
    <p class="lead">Use this page to detail your site's privacy policy.</p>
    
    <div class="alert alert-warning mt-5 shadow-sm" role="alert">
        <h4 class="alert-heading"><i class="bi bi-exclamation-triangle-fill"></i> VERY IMPORTANT POLICY</h4>
        <p class="mb-0 fs-5">
            Please do not steal this project. I do not want data theft, identity theft, or worst of all... 
            <strong>a ZERO on my project!</strong> 
        </p>
        <hr>
        <p class="mb-0 small text-muted">Seriously though, all your data is safe with us (I am deleting this project the moment I am done with it).</p>
    </div>
</div>
