@{
    ViewData["Title"] = "AI Fitness Plan";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-gradient text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <h4 class="mb-0"><i class="bi bi-robot"></i> AI Fitness Plan Generator</h4>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-4">
                        Enter your personal information and get an AI-powered custom exercise and nutrition plan!
                    </p>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
                        </div>
                    }

                    <form asp-action="Generate" method="post" enctype="multipart/form-data" id="aiForm">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold"><i class="bi bi-speedometer2"></i> Weight (kg)</label>
                                <input type="number" name="weight" class="form-control form-control-lg" placeholder="75" required min="30" max="300" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold"><i class="bi bi-arrows-vertical"></i> Height (cm)</label>
                                <input type="number" name="height" class="form-control form-control-lg" placeholder="175" required min="100" max="250" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold"><i class="bi bi-calendar"></i> Age</label>
                                <input type="number" name="age" class="form-control form-control-lg" placeholder="25" required min="15" max="100" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold"><i class="bi bi-gender-ambiguous"></i> Gender</label>
                                <select name="gender" class="form-select form-select-lg" required>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold"><i class="bi bi-bullseye"></i> Your Goal</label>
                            <select name="goal" class="form-select form-select-lg" required>
                                <option value="Lose Weight">🔥 Lose Weight</option>
                                <option value="Build Muscle">💪 Build Muscle</option>
                                <option value="Stay Fit">🏃 Stay Fit</option>
                                <option value="Increase Endurance">🚴 Increase Endurance</option>
                                <option value="Improve Flexibility">🧘 Improve Flexibility</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold"><i class="bi bi-camera"></i> Body Photo (Optional)</label>
                            <input type="file" name="photo" id="photoInput" class="form-control form-control-lg" accept="image/*" />
                            
                            <div id="pasteArea" class="border border-2 border-dashed rounded p-4 mt-2 text-center" style="cursor: pointer; border-color: #667eea !important;">
                                <i class="bi bi-clipboard fs-3 text-muted"></i>
                                <p class="text-muted mb-0">Click here and press <kbd>Ctrl+V</kbd> to paste an image from clipboard</p>
                            </div>
                            
                            <div id="imagePreview" class="mt-2 text-center d-none">
                                <img id="previewImg" src="" alt="Preview" class="img-thumbnail" style="max-height: 200px;" />
                                <button type="button" class="btn btn-sm btn-outline-danger ms-2" id="removeImage">
                                    <i class="bi bi-trash"></i> Remove
                                </button>
                            </div>
                            
                            <div class="form-text">
                                <i class="bi bi-info-circle"></i> Upload or paste a photo for the AI to visually analyze your current physique.
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-lg text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                <i class="bi bi-stars"></i> Generate My Plan
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-4">
                <p class="text-muted small">
                    <i class="bi bi-shield-check"></i> Powered by Google Gemini AI
                </p>
            </div>
        </div>
    </div>
</div>

<script>
    const pasteArea = document.getElementById('pasteArea');
    const photoInput = document.getElementById('photoInput');
    const imagePreview = document.getElementById('imagePreview');
    const previewImg = document.getElementById('previewImg');
    const removeBtn = document.getElementById('removeImage');

    // Handle paste events
    pasteArea.addEventListener('click', () => pasteArea.focus());
    pasteArea.setAttribute('tabindex', '0');

    pasteArea.addEventListener('paste', function(e) {
        e.preventDefault();
        const items = e.clipboardData.items;
        
        for (let i = 0; i < items.length; i++) {
            if (items[i].type.indexOf('image') !== -1) {
                const file = items[i].getAsFile();
                handleImageFile(file);
                break;
            }
        }
    });

    // Handle file input change
    photoInput.addEventListener('change', function() {
        if (this.files && this.files[0]) {
            handleImageFile(this.files[0]);
        }
    });

    // Handle image file
    function handleImageFile(file) {
        const reader = new FileReader();
        reader.onload = function(e) {
            previewImg.src = e.target.result;
            imagePreview.classList.remove('d-none');
            pasteArea.classList.add('d-none');
        };
        reader.readAsDataURL(file);

        // Create a new DataTransfer to set the file input
        const dataTransfer = new DataTransfer();
        dataTransfer.items.add(file);
        photoInput.files = dataTransfer.files;
    }

    // Remove image
    removeBtn.addEventListener('click', function() {
        photoInput.value = '';
        previewImg.src = '';
        imagePreview.classList.add('d-none');
        pasteArea.classList.remove('d-none');
    });

    // Global paste handler
    document.addEventListener('paste', function(e) {
        if (document.activeElement === pasteArea) return; // Already handled
        
        const items = e.clipboardData.items;
        for (let i = 0; i < items.length; i++) {
            if (items[i].type.indexOf('image') !== -1) {
                const file = items[i].getAsFile();
                handleImageFile(file);
                break;
            }
        }
    });
</script>
