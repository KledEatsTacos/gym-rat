@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Book Appointment";
    var trainers = ViewData["TrainerId"] as SelectList;
    var services = ViewData["ServiceId"] as SelectList;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-calendar-plus"></i> Book an Appointment</h4>
                </div>
                <div class="card-body">
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Any(x => x.Value?.Errors.Count > 0))
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle"></i>
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <span>@error.ErrorMessage</span>
                            }
                        </div>
                    }

                    <form asp-action="Create" method="post" id="appointmentForm">
                        <div class="mb-4">
                            <label class="form-label fw-bold"><i class="bi bi-person"></i> Select Trainer</label>
                            <select name="TrainerId" id="trainerSelect" class="form-select form-select-lg" required>
                                <option value="">-- Choose a Trainer --</option>
                                @if (trainers != null)
                                {
                                    @foreach (var trainer in trainers)
                                    {
                                        <option value="@trainer.Value">@trainer.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        
                        <div class="mb-4">
                            <label class="form-label fw-bold"><i class="bi bi-list-check"></i> Select Service</label>
                            <select name="ServiceId" id="serviceSelect" class="form-select form-select-lg" required>
                                <option value="">-- Choose a Service --</option>
                                @if (services != null)
                                {
                                    @foreach (var service in services)
                                    {
                                        <option value="@service.Value">@service.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold"><i class="bi bi-calendar"></i> Date</label>
                                <input type="date" id="datePart" class="form-control form-control-lg" 
                                       required min="@DateTime.Now.ToString("yyyy-MM-dd")" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold"><i class="bi bi-clock"></i> Time</label>
                                <select id="timePart" class="form-select form-select-lg" required disabled>
                                    <option value="">-- Select Date First --</option>
                                </select>
                                <div class="form-text" id="timeSlotHelp">Available slots based on trainer's schedule.</div>
                            </div>
                        </div>

                        <input type="hidden" name="AppointmentDate" id="appointmentDate" />
                        
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-arrow-left"></i> Back
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg" id="submitBtn" disabled>
                                <i class="bi bi-check-lg"></i> Book Appointment
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const trainerSelect = document.getElementById('trainerSelect');
            const dateInput = document.getElementById('datePart');
            const timeSelect = document.getElementById('timePart');
            const submitBtn = document.getElementById('submitBtn');
            const appointmentDateInput = document.getElementById('appointmentDate');
            const timeSlotHelp = document.getElementById('timeSlotHelp');

            function updateTimeSlots() {
                const trainerId = trainerSelect.value;
                const date = dateInput.value;

                if (!trainerId || !date) {
                    timeSelect.innerHTML = '<option value="">-- Select Trainer & Date --</option>';
                    timeSelect.disabled = true;
                    submitBtn.disabled = true;
                    return;
                }

                // Show loading state
                timeSelect.innerHTML = '<option>Loading availability...</option>';
                timeSelect.disabled = true;
                submitBtn.disabled = true;

                // Call API (LINQ backed)
                fetch(`/api/trainersapi/${trainerId}/timeslots?date=${date}`)
                    .then(response => {
                        if (!response.ok) throw new Error("Failed to fetch");
                        return response.json();
                    })
                    .then(data => {
                        timeSelect.innerHTML = '';
                        
                        if (data.timeSlots && data.timeSlots.length > 0) {
                            const availableSlots = data.timeSlots.filter(s => s.available);
                            
                            if (availableSlots.length === 0) {
                                timeSelect.innerHTML = '<option value="">Fully booked for this date</option>';
                                timeSelect.disabled = true;
                                timeSlotHelp.className = "form-text text-danger";
                                timeSlotHelp.innerText = "No available slots left for this date.";
                            } else {
                                timeSelect.innerHTML = '<option value="">-- Select a Time --</option>';
                                availableSlots.forEach(slot => {
                                    const option = document.createElement('option');
                                    option.value = slot.time;
                                    option.text = slot.time;
                                    timeSelect.appendChild(option);
                                });
                                timeSelect.disabled = false;
                                timeSlotHelp.className = "form-text text-success";
                                timeSlotHelp.innerText = `${availableSlots.length} available slots found.`;
                            }
                        } else {
                            timeSelect.innerHTML = '<option value="">No slots configured</option>';
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        timeSelect.innerHTML = '<option value="">Error loading slots</option>';
                        timeSlotHelp.innerText = "Could not check availability.";
                    });
            }

            // Update hidden field on submission
            document.getElementById('appointmentForm').addEventListener('submit', function(e) {
                const date = dateInput.value;
                const time = timeSelect.value;
                
                if(date && time) {
                    appointmentDateInput.value = date + 'T' + time;
                } else {
                    e.preventDefault();
                    alert("Please select a valid time.");
                }
            });

            // Listeners
            trainerSelect.addEventListener('change', updateTimeSlots);
            dateInput.addEventListener('change', updateTimeSlots);
            timeSelect.addEventListener('change', function() {
                submitBtn.disabled = !this.value;
            });
            
            // Initial check if fields are pre-filled
            if(trainerSelect.value && dateInput.value) updateTimeSlots();
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
