@model IEnumerable<gym_rat.Models.Appointment>

@{
    ViewData["Title"] = "Manage Appointments";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold">
            <i class="bi bi-clipboard-check"></i> Pending Appointments
        </h1>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-list"></i> View All
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <i class="bi bi-check-circle fs-1"></i>
            <p class="mt-2">No pending appointments to review!</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-warning text-dark d-flex justify-content-between">
                            <span><i class="bi bi-clock"></i> Pending Approval</span>
                            <small>@item.AppointmentDate.ToString("MMM dd, HH:mm")</small>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">@item.Service?.Name</h5>
                            <p class="card-text mb-1">
                                <i class="bi bi-person"></i> <strong>Member:</strong> @item.Member?.Email
                            </p>
                            <p class="card-text mb-1">
                                <i class="bi bi-person-badge"></i> <strong>Trainer:</strong> @item.Trainer?.FirstName @item.Trainer?.LastName
                            </p>
                            <p class="card-text">
                                <i class="bi bi-calendar"></i> <strong>Date:</strong> @item.AppointmentDate.ToString("dddd, MMM dd, yyyy")
                            </p>
                            <p class="card-text">
                                <i class="bi bi-clock"></i> <strong>Time:</strong> @item.AppointmentDate.ToString("HH:mm")
                            </p>
                        </div>
                        <div class="card-footer bg-white d-flex justify-content-end gap-2">
                            <form asp-action="Reject" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger">
                                    <i class="bi bi-x-lg"></i> Reject
                                </button>
                            </form>
                            <form asp-action="Approve" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-check-lg"></i> Approve
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
