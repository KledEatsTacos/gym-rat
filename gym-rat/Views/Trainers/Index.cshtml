@model IEnumerable<gym_rat.Models.Trainer>

@{
    ViewData["Title"] = "Our Trainers";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Meet Our Expert Trainers</h1>
        <p class="lead text-muted">Dedicated professionals to help you achieve your fitness goals</p>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <div class="mb-4">
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Add New Trainer
            </a>
        </div>
    }

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center">
                <div class="alert alert-info">
                    No trainers found. Check back soon!
                </div>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body text-center">
                            <div class="mb-3">
                                <i class="bi bi-person-circle display-1 text-secondary"></i>
                            </div>
                            <h5 class="card-title fw-bold">@item.FirstName @item.LastName</h5>
                            <p class="card-text text-primary fw-bold">@item.Specialization</p>
                            <p class="card-text text-muted small">
                                <i class="bi bi-clock"></i> Available: @item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")
                            </p>

                        </div>
                        <div class="card-footer bg-white border-0 pb-4 text-center">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm">
                                <i class="bi bi-eye"></i> Details
                            </a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

