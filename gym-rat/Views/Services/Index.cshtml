@model IEnumerable<gym_rat.Models.Service>

@{
    ViewData["Title"] = "Our Services";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Premium Services</h1>
        <p class="lead text-muted">Choose the perfect class or session for your needs</p>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <div class="mb-4">
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Add New Service
            </a>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="table-responsive shadow-sm rounded">
                <table class="table table-hover align-middle mb-0 bg-white">
                    <thead class="bg-light">
                        <tr>
                            <th class="py-3 ps-4">Service Name</th>
                            <th class="py-3">Description</th>
                            <th class="py-3 text-center">Duration</th>
                            <th class="py-3 text-center">Price</th>
                            <th class="py-3 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">No services available at the moment.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@item.Name</td>
                                    <td class="text-muted">@item.Description</td>
                                    <td class="text-center"><span class="badge bg-secondary">@item.DurationMinutes min</span></td>
                                    <td class="text-center fw-bold text-primary">@item.Price.ToString("C")</td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

