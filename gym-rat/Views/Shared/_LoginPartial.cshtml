@using Microsoft.AspNetCore.Identity
@using gym_rat.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    @if (User.IsInRole("Admin"))
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle text-warning" href="#" role="button" data-bs-toggle="dropdown">
                <i class="bi bi-gear"></i> Admin
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" asp-controller="Trainers" asp-action="Index"><i class="bi bi-people"></i> Manage Trainers</a></li>
                <li><a class="dropdown-item" asp-controller="Services" asp-action="Index"><i class="bi bi-list-check"></i> Manage Services</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" asp-controller="Appointments" asp-action="Manage"><i class="bi bi-clipboard-check"></i> Pending Appointments</a></li>
            </ul>
        </li>
    }
    <li class="nav-item">
        <a class="nav-link" asp-controller="Appointments" asp-action="Index">
            <i class="bi bi-calendar-check"></i> My Appointments
        </a>
    </li>
    <li class="nav-item">
        <span class="nav-link text-light">
            <i class="bi bi-person-circle"></i> @User.Identity?.Name
        </span>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="btn btn-outline-danger btn-sm ms-2">
                <i class="bi bi-box-arrow-right"></i> Logout
            </button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">
            <i class="bi bi-box-arrow-in-right"></i> Login
        </a>
    </li>
    <li class="nav-item d-flex align-items-center">
        <a class="btn btn-primary btn-sm" asp-area="Identity" asp-page="/Account/Register">
            <i class="bi bi-person-plus"></i> Join Now
        </a>
    </li>
}
</ul>


